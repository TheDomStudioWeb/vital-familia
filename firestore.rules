rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Licencias ----------
    function lic(uid) { return /databases/$(database)/documents/licencias/$(uid); }
    function esAdmin() { return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function vigente(d) { return d.get('plan','') == 'cortesia' || (d.get('vence', null) is timestamp && d.vence > request.time); }
    // Un plan pago (mensual/anual) o de cortesía cubre a la familia. Lo puede pagar quien creó
    // el grupo (owner) o cualquier integrante que se anote como pagador. Pago: hasta 6 miembros; cortesía: sin tope.
    function cubre(uid, f) {
      return uid is string && uid != '' && exists(lic(uid))
        && ( get(lic(uid)).data.get('plan','') == 'cortesia'
             || ( get(lic(uid)).data.get('plan','') in ['mensual','anual'] && vigente(get(lic(uid)).data) && f.members.size() <= 6 ) );
    }
    function porFamilia(d) {
      let fid = d.get('familia', '');
      let fref = /databases/$(database)/documents/families/$(fid);
      return fid is string && fid != '' && exists(fref)
        && request.auth.uid in get(fref).data.members
        && ( cubre(get(fref).data.owner, get(fref).data) || cubre(get(fref).data.get('pagador',''), get(fref).data) );
    }
    function cubierto() {
      return request.auth != null && exists(lic(request.auth.uid))
        && ( vigente(get(lic(request.auth.uid)).data) || porFamilia(get(lic(request.auth.uid)).data) );
    }

    // Un integrante puede ver el plan de quien paga su familia (para mostrar «Te cubre tu familia»)
    function veoPlanDeFamilia(lid) {
      let fid = resource.data.get('familia', '');
      let fref = /databases/$(database)/documents/families/$(fid);
      return fid is string && fid != '' && exists(fref)
        && request.auth.uid in get(fref).data.members
        && ( get(fref).data.owner == lid || get(fref).data.get('pagador','') == lid );
    }

    match /licencias/{lid} {
      allow get: if request.auth != null && (request.auth.uid == lid || esAdmin() || veoPlanDeFamilia(lid));
      allow list: if esAdmin();
      // Cada cuenta nueva puede crearse su prueba gratis de 14 días (una sola vez)
      allow create: if request.auth != null && request.auth.uid == lid
        && request.resource.data.plan == 'prueba'
        && request.resource.data.vence is timestamp
        && request.resource.data.vence <= request.time + duration.value(15, 'd')
        && request.resource.data.keys().hasOnly(['plan','vence','email','nombre','creado','familia']);
      // El usuario solo puede actualizar su familia, mail y nombre; el resto lo cambia el administrador o el cobrador
      allow update: if (request.auth != null && request.auth.uid == lid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['familia','email','nombre'])) || esAdmin();
      allow delete: if esAdmin();
    }
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }

    // Datos privados de cada persona: solo su dueño
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid && cubierto();
      match /days/{day} {
        allow read, write: if request.auth != null && request.auth.uid == uid && cubierto();
      }
    }

    // Códigos de invitación: se pueden consultar uno por uno, nunca listar
    match /codes/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.keys().hasOnly(['fid']);
    }

    // Grupos familiares
    match /families/{fid} {
      allow get: if request.auth != null && (request.auth.uid in resource.data.members || esAdmin());
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      allow update: if request.auth != null && (
        resource.data.owner == request.auth.uid ||
        // Un integrante con plan pago propio se anota como el que paga la familia
        ( request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pagador'])
          && request.resource.data.pagador == request.auth.uid
          && request.auth.uid in resource.data.members
          && exists(lic(request.auth.uid))
          && get(lic(request.auth.uid)).data.get('plan','') in ['mensual','anual','cortesia']
          && vigente(get(lic(request.auth.uid)).data) ) ||
        ( request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() <= 40 )
      );

      // Recetas compartidas por la familia
      match /recipes/{rid} {
        allow read, write: if request.auth != null && cubierto()
          && request.auth.uid in get(/databases/$(database)/documents/families/$(fid)).data.members;
      }

      // Resumen público de actividad (sin datos de salud)
      match /members/{uid} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/families/$(fid)).data.members;
        allow write: if request.auth != null && request.auth.uid == uid && cubierto()
          && request.auth.uid in get(/databases/$(database)/documents/families/$(fid)).data.members;
      }
    }
  }
}
